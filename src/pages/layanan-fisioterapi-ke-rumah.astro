---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../consts';

export const prerender = true;

const title = "Fisioterapi di Rumah Jakarta & Tangerang — Stroke & Lansia | Joy of Care";
const description = "Layanan fisioterapi di rumah Jakarta & Tangerang untuk rehabilitasi pasca stroke, latihan fisioterapi lansia, cegah jatuh, dan Parkinson. Fisioterapis berizin Dinkes. Chat WA 08811-118-911.";
const canonical = `${SITE_URL}/layanan-fisioterapi-ke-rumah/`;

const faqData = [
  {
    question: "Kapan pasien membutuhkan layanan fisioterapi di rumah?",
    answer: "Fisioterapi di rumah sangat dibutuhkan oleh pasien pasca-stroke yang memerlukan stimulasi motorik neuro-plastisitas dini, pasien pasca-operasi penggantian sendi panggul/lutut (THR/TKR), lansia dengan penurunan keseimbangan tubuh (risiko jatuh tinggi), penderita Parkinson, saraf kejepit (HNP), dan osteoarthritis yang sulit bepergian ke rumah sakit."
  },
  {
    question: "Berapa kali frekuensi fisioterapi di rumah yang ideal dalam seminggu?",
    answer: "Untuk rehabilitasi stroke pada fase jendela emas (golden period) dan pemulihan pasca operasi akut, disarankan 3 hingga 4 sesi per minggu. Untuk pemeliharaan mobilitas lansia, latihan keseimbangan geriatri, atau kondisi Parkinson kronis, 2 sesi per minggu umumnya cukup untuk mempertahankan fungsi gerak mandiri."
  },
  {
    question: "Apakah fisioterapis membawa peralatan terapi langsung ke rumah?",
    answer: "Ya. Fisioterapis Joy of Care membawa perlengkapan fisioterapi portabel lengkap berstandar medis, termasuk alat TENS (terapi stimulasi listrik pereda nyeri), lampu inframerah (infrared radiation therapy), theraband, goniometer pengukur lingkup gerak sendi, serta matras dan sabuk pengaman transfer gerak (gait belt)."
  },
  {
    question: "Bagaimana cara memesan dan berapa biaya fisioterapi di rumah Joy of Care?",
    answer: "Pemesanan sangat mudah melalui WhatsApp 08811-118-911. Tim fisioterapi kami akan melakukan asesmen keluhan dan mencocokkan jadwal terapi yang paling nyaman bagi Anda. Tarif bersifat all-in dan sudah termasuk biaya transport terapis ke seluruh area Jabodetabek."
  }
];
---

<BaseLayout title={title} description={description} canonicalURL={canonical}>
  <!-- Schema: MedicalTherapy -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalTherapy",
    "name": "Layanan Fisioterapi di Rumah Joy of Care",
    "description": description,
    "url": canonical,
    "provider": {
      "@type": "MedicalBusiness",
      "name": "Joy of Care",
      "telephone": "+628811118911",
      "url": `${SITE_URL}/`
    },
    "areaServed": ["Jakarta", "Tangerang", "Tangerang Selatan", "Depok", "Bogor"]
  })} />

  <!-- Schema: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${SITE_URL}/` },
      { "@type": "ListItem", "position": 2, "name": "Layanan", "item": `${SITE_URL}/layanan-lengkap/` },
      { "@type": "ListItem", "position": 3, "name": "Fisioterapi di Rumah", "item": canonical }
    ]
  })} />

  <!-- Schema: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqData.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  })} />

  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Beranda</a> <span>›</span>
        <a href="/layanan-lengkap/">Layanan</a> <span>›</span>
        Fisioterapi di Rumah
      </nav>
      <h1>Fisioterapi <span class="text-primary">di Rumah</span> Jakarta & Tangerang</h1>
      <p>Layanan fisioterapi profesional di rumah untuk pemulihan pasca stroke, latihan fisioterapi lansia, cegah jatuh, pasca operasi, dan Parkinson. Fisioterapis berlisensi resmi siap datang ke kediaman Anda.</p>
      <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20fisioterapi%20di%20rumah" class="btn btn-primary" style="margin-top:20px" target="_blank" rel="noopener noreferrer">Jadwalkan Fisioterapi via WhatsApp</a>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <h2 style="font-family:Montserrat,sans-serif;font-size:1.8rem;font-weight:700;margin-bottom:16px">Pemulihan Mobilitas Tanpa Stres Perjalanan</h2>
      <p>Layanan <strong>fisioterapi di rumah</strong> dari Joy of Care menghadirkan rehabilitasi fisik intensif langsung di ruang keluarga Anda. Menempuh perjalanan jauh menuju klinik fisioterapi atau instalasi rehabilitasi medik rumah sakit di Jakarta sering kali memicu kelelahan fisik berat bagi pasien stroke atau lansia yang memiliki mobilitas terbatas. Dengan sesi 1-on-1 di rumah, pasien mendapatkan perhatian penuh dan program latihan yang disesuaikan secara presisi dengan arsitektur rumah nyata pasien.</p>
      <p>Setiap fisioterapis kami memiliki Surat Tanda Registrasi (STR) aktif dari Ikatan Fisioterapi Indonesia (IFI) dan berpengalaman dalam protokol rehabilitasi geriatri, neurologi, ortopedi, dan kardiorespirasi.</p>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0">
        <img src="/images/layanan-fisioterapi-ke-rumah/1.jpg" alt="Fisioterapis Joy of Care memandu latihan keseimbangan pasien lansia di rumah" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
        <img src="/images/layanan-fisioterapi-ke-rumah/2.jpg" alt="Rehabilitasi fisioterapi pasca stroke di rumah Jakarta" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Program Fisioterapi Unggulan Joy of Care</h2>
      <p class="section-subtitle">Didesain khusus untuk pemulihan optimal berbagai kondisi medis:</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px">
        <div style="background:#f7fafc;padding:24px;border-radius:12px">
          <h4 style="margin-bottom:8px;color:var(--color-primary);font-size:1.1rem">🧠 Fisioterapi Pasca Stroke</h4>
          <p style="color:#4a5568;font-size:.92rem">Stimulasi gerak anggota tubuh lumpuh/lemah (hemiparesis), latihan transfer tempat tidur-kursi, latihan berjalan, dan pencegahan kekakuan sendi permanen (kontraktur).</p>
        </div>
        <div style="background:#f7fafc;padding:24px;border-radius:12px">
          <h4 style="margin-bottom:8px;color:var(--color-primary);font-size:1.1rem">👵 Fisioterapi Lansia & Cegah Jatuh</h4>
          <p style="color:#4a5568;font-size:.92rem">Penguatan otot kuadrisep tungkai, latihan keseimbangan dinamis, koordinasi visual-motorik, dan edukasi modifikasi rumah guna menekan risiko jatuh fatal.</p>
        </div>
        <div style="background:#f7fafc;padding:24px;border-radius:12px">
          <h4 style="margin-bottom:8px;color:var(--color-primary);font-size:1.1rem">🦴 Pasca Operasi Panggul & Lutut</h4>
          <p style="color:#4a5568;font-size:.92rem">Rehabilitasi bertahap pasca operasi penggantian panggul total (THR), penggantian lutut (TKR), dan pemulihan fraktur tulang untuk berjalan mandiri.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Kenapa Memilih Joy of Care</h2>
      <p class="section-subtitle">Layanan kesehatan profesional langsung ke rumah Anda, tanpa antre dan tanpa keluar rumah.</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🏠</div><h3 style="margin:8px 0">Kenyamanan di Rumah</h3>
          <p style="color:#4a5568;font-size:.95rem">Pasien berlatih langsung di lingkungan aslinya (tangga rumah, kamar tidur, toilet) untuk kemandirian fungsional harian.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">👨‍⚕️</div><h3 style="margin:8px 0">Fisioterapis Berizin Resmi</h3>
          <p style="color:#4a5568;font-size:.95rem">Seluruh fisioterapis memiliki STR IFI resmi, ramah, telaten, dan berdedikasi tinggi merawat pasien geriatri.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🕒</div><h3 style="margin:8px 0">Jadwal Sangat Fleksibel</h3>
          <p style="color:#4a5568;font-size:.95rem">Tersedia 7 hari seminggu (pagi hingga malam), sehingga sesi terapi tidak mengganggu rutinitas harian keluarga.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Pertanyaan yang Sering Ditanyakan (FAQ)</h2>
      <div class="faq-list">
        {faqData.map(f => (
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">{f.question}</button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{f.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Mulai Sesi Pemulihan Bersama Joy of Care</h2>
        <p>Konsultasikan kondisi pasien hari ini dan dapatkan rencana latihan fisioterapi terbaik di rumah Anda.</p>
        <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20konsultasi%20fisioterapi%20stroke%20dan%20lansia" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">Konsultasi Fisioterapi via WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    padding: 48px 0 32px;
  }
  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }
  .breadcrumbs a {
    color: var(--color-primary);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .content-section {
    padding: 60px 0;
  }
  .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 12px;
  }
  .section-subtitle {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto 48px;
  }
  .cta-banner {
    background: linear-gradient(135deg, var(--color-primary) 0%, #247A3B 100%);
    color: white;
    padding: 48px;
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .cta-banner h2 {
    font-size: 1.8rem;
    margin-bottom: 12px;
    color: white;
  }
  .cta-banner p {
    font-size: 1.05rem;
    opacity: 0.95;
    margin-bottom: 24px;
  }
  .btn-lg {
    font-size: 1.05rem;
    padding: 14px 32px;
  }
</style>
