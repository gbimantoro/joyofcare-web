---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../consts';

export const prerender = true;

const title = "Layanan Fisioterapi Ke Rumah";
const description = "Layanan fisioterapi profesional di rumah Anda. Pemulihan pasca operasi, cedera, stroke, dan nyeri kronis. Joy of Care melayani BSD, Tangerang, Jakarta. Chat WA 08811-118-911.";
const canonical = `${SITE_URL}/layanan-fisioterapi-ke-rumah`;
---

<BaseLayout title={title} description={description} canonicalURL={canonical}>


  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a> <span>›</span> Fisioterapi</nav>
      <h1>Fisioterapi <span class="text-primary">di Rumah</span></h1>
      <p>Layanan fisioterapi profesional di rumah untuk pemulihan pasca operasi, stroke, cedera, dan nyeri kronis. Joy of Care melayani BSD, Tangerang, Jakarta, Depok, dan Bogor.</p>
      <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20fisioterapi" class="btn btn-primary" style="margin-top:20px">Chat WhatsApp Sekarang</a>
    </div>
  </section>

  
  <section class="content-section">
    <div class="container">
      <h2 style="font-family:Montserrat,sans-serif;font-size:1.8rem;font-weight:700;margin-bottom:16px">Layanan Fisioterapi Datang ke Rumah</h2>
      <p>Fisioterapi di rumah membantu pemulihan mobilitas dan mengurangi nyeri tanpa harus ke klinik. Layanan ini cocok untuk pasien pasca operasi, lansia yang kesulitan bepergian, pasien stroke, dan individu dengan nyeri kronis yang membutuhkan terapi rutin.</p>
      <p>Fisioterapis kami berlisensi dan berpengalaman menangani pemulihan pasca operasi tulang dan sendi, rehabilitasi stroke, cedera olahraga, nyeri punggung, hingga terapi anak dengan kebutuhan khusus.</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:20px 0">
        <img src="/images/layanan-fisioterapi-ke-rumah/1.jpg" alt="Fisioterapis Joy of Care memandu latihan pemulihan pasien" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
        <img src="/images/layanan-fisioterapi-ke-rumah/2.jpg" alt="Terapi fisioterapi di rumah untuk pasien lansia" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
      </div>
    </div>
  </section>


  
  <section class="section">
    <div class="container">
      <h2 class="section-title">Siapa yang Membutuhkan Fisioterapi di Rumah?</h2>
      <p class="section-subtitle">Dapat dimanfaatkan oleh berbagai kelompok, tergantung kebutuhan spesifik:</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px">
        <div style="background:#f7fafc;padding:20px;border-radius:12px"><h4 style="margin-bottom:6px">Individu Lanjut Usia</h4><p style="color:#4a5568;font-size:.92rem">Lansia dengan gangguan mobilitas, arthritis, osteoporosis, atau kondisi yang memengaruhi pergerakan.</p></div>
        <div style="background:#f7fafc;padding:20px;border-radius:12px"><h4 style="margin-bottom:6px">Pasien Neurologis</h4><p style="color:#4a5568;font-size:.92rem">Pasien stroke, multiple sclerosis, atau Parkinson yang membutuhkan rehabilitasi fungsi gerak.</p></div>
        <div style="background:#f7fafc;padding:20px;border-radius:12px"><h4 style="margin-bottom:6px">Pasien Pasca Operasi</h4><p style="color:#4a5568;font-size:.92rem">Pemulihan setelah operasi lutut, panggul, tulang belakang, dan prosedur lainnya.</p></div>
        <div style="background:#f7fafc;padding:20px;border-radius:12px"><h4 style="margin-bottom:6px">Nyeri Kronis</h4><p style="color:#4a5568;font-size:.92rem">Fibromyalgia, nyeri punggung kronis, dan nyeri leher yang membaik dengan terapi terarah.</p></div>
        <div style="background:#f7fafc;padding:20px;border-radius:12px"><h4 style="margin-bottom:6px">Cedera Kronis/Akut</h4><p style="color:#4a5568;font-size:.92rem">Cedera olahraga, kecelakaan kerja, atau kecelakaan yang memerlukan latihan pemulihan.</p></div>
        <div style="background:#f7fafc;padding:20px;border-radius:12px"><h4 style="margin-bottom:6px">Rehabilitasi Jangka Panjang</h4><p style="color:#4a5568;font-size:.92rem">Kondisi medis yang memerlukan fisioterapi rutin berkelanjutan di rumah.</p></div>
      </div>
      <p style="text-align:center;margin-top:24px"><strong>Area layanan:</strong> BSD City, Tangerang Selatan, Tangerang, Jakarta (Barat &amp; Selatan), Depok, dan Bogor.</p>
    </div>
  </section>


  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Kenapa Memilih Joy of Care</h2>
      <p class="section-subtitle">Layanan kesehatan profesional langsung ke rumah Anda, tanpa antre dan tanpa keluar rumah.</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🏠</div><h3 style="margin:8px 0">Kenyamanan di Rumah</h3>
          <p style="color:#4a5568;font-size:.95rem">Tidak perlu repot ke fasilitas kesehatan. Tenaga medis kami datang langsung ke rumah Anda.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">👨‍⚕️</div><h3 style="margin:8px 0">Tenaga Medis Profesional</h3>
          <p style="color:#4a5568;font-size:.95rem">Dokter, perawat, dan terapis berlisensi serta berpengalaman menangani pasien di rumah.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🕒</div><h3 style="margin:8px 0">Fleksibilitas Waktu</h3>
          <p style="color:#4a5568;font-size:.95rem">Kami siap melayani setiap hari, termasuk akhir pekan, sesuai jadwal yang Anda pilih.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🤝</div><h3 style="margin:8px 0">Perawatan Bersahabat</h3>
          <p style="color:#4a5568;font-size:.95rem">Tim kami peduli pada kesehatan Anda dan memberikan pendampingan yang ramah dan personal.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">💻</div><h3 style="margin:8px 0">Teknologi Terkini</h3>
          <p style="color:#4a5568;font-size:.95rem">Riwayat medis dipantau dan dikelola dengan teliti melalui sistem yang modern.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">📋</div><h3 style="margin:8px 0">Layanan Medis Lengkap</h3>
          <p style="color:#4a5568;font-size:.95rem">Pemeriksaan rutin lansia, perawatan luka, infus, vaksinasi, hingga fisioterapi di rumah.</p>
        </div>
      </div>
    </div>
  </section>

<section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Pertanyaan yang Sering Ditanyakan</h2>
      <div class="faq-list">
        <div class="faq-item"><button class="faq-question">Kapan fisioterapi di rumah diperlukan?</button><div class="faq-answer"><div class="faq-answer-inner">Fisioterapi di rumah cocok untuk pasien pasca operasi, lansia yang kesulitan bepergian, pasien stroke, dan individu dengan nyeri kronis yang membutuhkan terapi rutin.</div></div></div>
        <div class="faq-item"><button class="faq-question">Bagaimana cara menjadwalkan fisioterapi?</button><div class="faq-answer"><div class="faq-answer-inner">Hubungi WhatsApp kami di 08811-118-911. Fisioterapis akan datang ke rumah Anda sesuai jadwal yang disepakati.</div></div></div>
        <div class="faq-item"><button class="faq-question">Area layanan fisioterapi mencakup mana saja?</button><div class="faq-answer"><div class="faq-answer-inner">Kami melayani BSD City, Tangerang Selatan, Tangerang, Jakarta (Barat, Selatan), Depok, dan Bogor.</div></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Siap Memulai?</h2>
        <p>Hubungi kami sekarang untuk konsultasi atau informasi lebih lanjut.</p>
        <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20fisioterapi" class="btn btn-lg">Chat WhatsApp</a>
      </div>
    </div>
  </section>

  
</BaseLayout>
