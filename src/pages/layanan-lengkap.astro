---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceRelatedArticles from '../components/ServiceRelatedArticles.astro';
import { SITE_URL } from '../consts';

export const prerender = true;

const title = 'Layanan Kesehatan di Rumah | Joy of Care';
const description = 'Pilih layanan kesehatan di rumah Joy of Care: panggil dokter, fisioterapi, perawat, infus vitamin, home lab, akupuntur, dan antar jemput RS. Chat WA 08811-118-911.';
const canonical = `${SITE_URL}/layanan-lengkap/`;
---

<BaseLayout title={title} description={description} canonicalURL={canonical}>
  <!-- Schema: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${SITE_URL}/` },
      { "@type": "ListItem", "position": 2, "name": "Layanan Lengkap", "item": canonical }
    ]
  })} />

  <!-- Schema: ItemList (Layanan Medis) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Daftar Layanan Kesehatan di Rumah Joy of Care",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Panggil Dokter ke Rumah", "url": `${SITE_URL}/panggil-dokter-ke-rumah/` },
      { "@type": "ListItem", "position": 2, "name": "Fisioterapi di Rumah", "url": `${SITE_URL}/layanan-fisioterapi-ke-rumah/` },
      { "@type": "ListItem", "position": 3, "name": "Perawat Lansia Homecare", "url": `${SITE_URL}/layanan-perawat-di-rumah/` },
      { "@type": "ListItem", "position": 4, "name": "Vaksinasi di Rumah", "url": `${SITE_URL}/layanan-vaksinasi-di-rumah/` },
      { "@type": "ListItem", "position": 5, "name": "Infus & Suntik Vitamin", "url": `${SITE_URL}/infus-suntik-vitamin-di-rumah/` },
      { "@type": "ListItem", "position": 6, "name": "Home Lab Cek Darah", "url": `${SITE_URL}/homelab/` },
      { "@type": "ListItem", "position": 7, "name": "Akupuntur Medis di Rumah", "url": `${SITE_URL}/layanan-akupuntur-di-rumah/` },
      { "@type": "ListItem", "position": 8, "name": "Antar Jemput RS (TransCare)", "url": `${SITE_URL}/transcare-antar-jemput-ke-rs-jakarta-tangerang/` }
    ]
  })} />

  <section class="page-hero" style="text-align:center">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb" style="text-align:center">
        <a href="/">Beranda</a> <span>›</span> Layanan Lengkap
      </nav>
      <h1 style="text-align:center;margin-bottom:8px">Layanan Kesehatan di Rumah</h1>
      <p style="text-align:center;color:#555770;max-width:600px;margin:0 auto">Pilih layanan yang Anda butuhkan. Seluruh tindakan medis dikerjakan langsung di kediaman Anda oleh dokter, perawat, dan terapis berizin STR resmi.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="services-grid">
        <a href="/panggil-dokter-ke-rumah/" class="service-card">
          <div class="service-icon">🩺</div>
          <h3>Panggil Dokter ke Rumah</h3>
          <p>Dokter umum dan spesialis datang ke rumah untuk pemeriksaan fisik dan penanganan medis.</p>
          <span style="color:#00bf63;font-weight:600">Pelajari lebih lanjut →</span>
        </a>
        <a href="/layanan-fisioterapi-ke-rumah/" class="service-card">
          <div class="service-icon">💪</div>
          <h3>Fisioterapi di Rumah</h3>
          <p>Rehabilitasi stroke, Parkinson, pasca operasi, dan pemulihan nyeri sendi lansia.</p>
          <span style="color:#00bf63;font-weight:600">Pelajari lebih lanjut →</span>
        </a>
        <a href="/layanan-perawat-di-rumah/" class="service-card">
          <div class="service-icon">🏥</div>
          <h3>Perawat Lansia Homecare</h3>
          <p>Perawat profesional untuk pasang NGT, kateter, rawat luka modern, dan pendampingan 24 jam.</p>
          <span style="color:#00bf63;font-weight:600">Pelajari lebih lanjut →</span>
        </a>
        <a href="/layanan-vaksinasi-di-rumah/" class="service-card">
          <div class="service-icon">🛡️</div>
          <h3>Vaksinasi di Rumah</h3>
          <p>Vaksin influenza, pneumonia lansia, HPV, hingga vaksin syarat studi & visa luar negeri.</p>
          <span style="color:#00bf63;font-weight:600">Pelajari lebih lanjut →</span>
        </a>
        <a href="/infus-suntik-vitamin-di-rumah/" class="service-card">
          <div class="service-icon">💉</div>
          <h3>Infus & Suntik Vitamin</h3>
          <p>Vitamin C dosis tinggi, neurobion B kompleks, multivitamin imun booster, dan anti-fatigue.</p>
          <span style="color:#00bf63;font-weight:600">Pelajari lebih lanjut →</span>
        </a>
        <a href="/homelab/" class="service-card">
          <div class="service-icon">🔬</div>
          <h3>Home Lab Cek Darah</h3>
          <p>Pengambilan sampel darah steril di rumah, hasil cepat same-day, gratis konsultasi dokter.</p>
          <span style="color:#00bf63;font-weight:600">Pelajari lebih lanjut →</span>
        </a>
        <a href="/layanan-akupuntur-di-rumah/" class="service-card">
          <div class="service-icon">🎯</div>
          <h3>Akupuntur Medis di Rumah</h3>
          <p>Terapi akupuntur medis untuk nyeri sendi lansia, saraf kejepit, insomnia, dan pasca stroke.</p>
          <span style="color:#00bf63;font-weight:600">Pelajari lebih lanjut →</span>
        </a>
        <a href="/transcare-antar-jemput-ke-rs-jakarta-tangerang/" class="service-card">
          <div class="service-icon">🚑</div>
          <h3>Antar Jemput RS (TransCare)</h3>
          <p>Transportasi medis ramah lansia & kursi roda ke rumah sakit di Jabodetabek didampingi perawat.</p>
          <span style="color:#00bf63;font-weight:600">Pelajari lebih lanjut →</span>
        </a>
      </div>

      <div style="text-align:center;margin-top:40px">
        <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20layanan%20Joy%20of%20Care" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">Chat WhatsApp untuk Konsultasi Gratis</a>
      </div>
    </div>
  </section>

  <ServiceRelatedArticles
    categories={['panggil-dokter', 'perawat-homecare', 'fisioterapi-rumah', 'vaksinasi-rumah', 'infus-vitamin', 'home-lab']}
    title="Panduan Klinis & Edukasi Kesehatan Populer"
    subtitle="Rekomendasi artikel kesehatan terverifikasi dokter untuk panduan rawat mandiri dan pendampingan keluarga di rumah."
    limit={6}
    viewAllSlug="panggil-dokter"
    viewAllLabel="Kunjungi Pusat Edukasi Medis (Blog)"
  />

  <style>
    .page-hero {
      background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
      padding: calc(var(--nav-height) + 24px) 0 40px;
    }
    .breadcrumbs {
      padding: 0;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      margin-bottom: 16px;
    }
    .breadcrumbs a {
      color: var(--color-primary);
      text-decoration: none;
    }
    .breadcrumbs a:hover {
      text-decoration: underline;
    }
    @media (max-width: 768px) {
      .page-hero {
        padding: calc(var(--nav-height) + 12px) 0 24px;
      }
      .breadcrumbs {
        margin-bottom: 12px;
      }
    }
    .services-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; padding: 20px 0 40px; }
    .service-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 32px; text-align: center; transition: all 0.2s; text-decoration: none; color: inherit; }
    .service-card:hover { box-shadow: var(--shadow-md); border-color: var(--color-primary); transform: translateY(-2px); }
    .service-card h3 { margin: 16px 0 8px; font-size: 1.1rem; }
    .service-card p { color: var(--color-text-secondary); font-size: 0.92rem; margin: 0 0 16px; }
    .service-icon { font-size: 2.5rem; }
  </style>
</BaseLayout>