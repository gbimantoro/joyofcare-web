---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../consts';

export const prerender = true;

const title = "Antar Jemput Rumah Sakit Jakarta Harga Terjangkau & Nyaman | Joy of Care TransCare";
const description = "Layanan antar jemput rumah sakit Jakarta harga terjangkau & transparan. Transportasi medis pasien lansia, pasca operasi, kursi roda didampingi perawat bersertifikat.";
const canonical = `${SITE_URL}/transcare-antar-jemput-ke-rs-jakarta-tangerang/`;

const faqData = [
  {
    question: "Berapa kisaran harga dan tarif layanan antar jemput rumah sakit Jakarta bersama TransCare?",
    answer: "Harga layanan TransCare Joy of Care sangat terjangkau, adil, dan transparan. Tarif dihitung berdasarkan jarak tempuh lokasi penjemputan ke faskes tujuan, jenis armada (mobil reguler nyaman atau unit aksesibilitas kursi roda), serta kebutuhan pendampingan perawat medis. Semua biaya disampaikan di awal tanpa ada biaya tersembunyi."
  },
  {
    question: "Apakah armada TransCare dapat mengakomodasi pengguna kursi roda dan lansia sulit jalan?",
    answer: "Ya, armada TransCare didesain secara khusus untuk kemudahan akses lansia dan pasien tirah baring (bedridden), dengan pintu masuk lebar, lantai kabin rendah, serta fasilitas fiksasi kursi roda yang stabil dan aman selama mobil melaju."
  },
  {
    question: "Apakah pasien bisa didampingi oleh perawat medis selama perjalanan?",
    answer: "Tentu saja. Anda dapat memilih opsi layanan TransCare dengan pendampingan perawat berizin STR aktif yang siap memonitor tanda vital pasien, menjaga selang infus, NGT, atau kateter, serta membantu proses administrasi registrasi di rumah sakit."
  },
  {
    question: "Ke rumah sakit mana saja rute operasional TransCare dapat menjangkau?",
    answer: "TransCare melayani pengantaran dan penjemputan ke seluruh rumah sakit dan pusat rehabilitasi di area DKI Jakarta, BSD City, Tangerang Kota, Tangerang Selatan, Gading Serpong, Depok, dan Bogor (seperti RS Siloam, RS Mayapada, RS Pondok Indah, RSCM, RS Fatmawati, dll)."
  }
];
---

<BaseLayout title={title} description={description} canonicalURL={canonical}>
  <!-- Schema: MedicalProcedure -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": "Layanan Antar Jemput Rumah Sakit TransCare Jakarta Tangerang",
    "procedureType": "PatientTransferProcedure",
    "description": description,
    "url": canonical,
    "provider": {
      "@type": "MedicalBusiness",
      "name": "Joy of Care",
      "telephone": "+628811118911",
      "url": `${SITE_URL}/`
    },
    "areaServed": ["Jakarta", "Tangerang", "Tangerang Selatan", "Depok", "Bogor"]
  })} />

  <!-- Schema: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${SITE_URL}/` },
      { "@type": "ListItem", "position": 2, "name": "Layanan", "item": `${SITE_URL}/layanan-lengkap/` },
      { "@type": "ListItem", "position": 3, "name": "Antar Jemput RS", "item": canonical }
    ]
  })} />

  <!-- Schema: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqData.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  })} />

  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Beranda</a> <span>›</span>
        <a href="/layanan-lengkap/">Layanan</a> <span>›</span>
        Antar Jemput RS
      </nav>
      <h1>Antar Jemput Rumah Sakit Jakarta — <span class="text-primary">TransCare</span> Aman & Nyaman</h1>
      <p>Layanan transportasi medis ramah lansia, pengguna kursi roda, dan pasien pasca rawat inap. Armada higienis, driver terlatih patient-safety, dan opsi pendampingan perawat berlisensi.</p>
      <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20harga%20dan%20jadwal%20antar%20jemput%20RS%20TransCare" class="btn btn-primary" style="margin-top:20px" target="_blank" rel="noopener noreferrer">Jadwalkan TransCare via WhatsApp</a>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <h2 style="font-family:Montserrat,sans-serif;font-size:1.8rem;font-weight:700;margin-bottom:16px">TransCare: Antar Jemput Rumah Sakit Jakarta dengan Harga Transparan & Nyaman</h2>
      <p>Membawa orang tua lanjut usia, pasien stroke, atau keluarga yang baru selesai menjalani operasi kontrol ke rumah sakit sering kali menjadi momok yang melelahkan. Kendaraan pribadi atau taksi online konvensional tidak dirancang untuk mengakomodasi keterbatasan fisik dan keselamatan medis pasien. <strong>TransCare Joy of Care</strong> hadir memberikan standar transportasi medis non-darurat yang manusiawi dan aman di Jabodetabek.</p>
      <p>Armada kami dibersihkan secara steril setiap pergantian pasien, dilengkapi suspensi empuk untuk meminimalkan guncangan jalan, serta didampingi tim yang memahami protokol *patient handling* yang ramah dan sabar.</p>
      
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0">
        <img src="/images/transcare-antar-jemput-ke-rs-jakarta-tangerang/1.jpg" alt="Armada transportasi medis TransCare Joy of Care melayani antar jemput pasien rumah sakit di Jakarta" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
        <img src="/images/transcare-antar-jemput-ke-rs-jakarta-tangerang/2.jpg" alt="Perawat TransCare mendampingi pasien lansia di dalam kendaraan medis menuju rumah sakit" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
      </div>

      <h3 style="font-size:1.3rem;font-weight:700;margin:24px 0 12px">Pilihan Skema Layanan TransCare:</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px">
        <div style="background:#fff;padding:20px;border-radius:12px;border:1px solid var(--color-border)">
          <h4 style="color:var(--color-primary);margin-bottom:8px">1. Antar Jemput Kontrol Rutin Rawat Jalan</h4>
          <p style="color:#4a5568;font-size:.92rem;margin:0">Jemput tepat waktu dari rumah menuju klinik spesialis / RS, ditunggu selama konsultasi dokter berlangsung, dan diantar pulang kembali hingga ke dalam kamar tidur.</p>
        </div>
        <div style="background:#fff;padding:20px;border-radius:12px;border:1px solid var(--color-border)">
          <h4 style="color:var(--color-primary);margin-bottom:8px">2. Kepulangan Pasca Rawat Inap (Discharge RS)</h4>
          <p style="color:#4a5568;font-size:.92rem;margin:0">Penjemputan pasien pasca rawat inap, ICU, atau operasi bedah dari lobi rumah sakit dengan pengawasan posisi tubuh yang aman dan stabil.</p>
        </div>
        <div style="background:#fff;padding:20px;border-radius:12px;border:1px solid var(--color-border)">
          <h4 style="color:var(--color-primary);margin-bottom:8px">3. Pendampingan Perawat Medis On-Board</h4>
          <p style="color:#4a5568;font-size:.92rem;margin:0">Perawat berizin STR mendampingi sepanjang perjalanan untuk pemantauan tanda vital, pengaturan infus cairan, oksigen tabung, dan bantuan mobilitas.</p>
        </div>
        <div style="background:#fff;padding:20px;border-radius:12px;border:1px solid var(--color-border)">
          <h4 style="color:var(--color-primary);margin-bottom:8px">4. Transportasi Pasien Hemodialisis (Cuci Darah)</h4>
          <p style="color:#4a5568;font-size:.92rem;margin:0">Jadwal rutin teratur bagi pasien gagal ginjal yang menjalani sesi cuci darah mingguan, menjamin ketepatan waktu tanpa stres kemacetan lalu lintas.</p>
        </div>
      </div>

      <p>Untuk pasien yang membutuhkan pemulihan mobilitas lebih lanjut di rumah, padukan layanan ini dengan <a href="/layanan-fisioterapi-ke-rumah/">layanan fisioterapi stroke</a> atau <a href="/layanan-perawat-di-rumah/">perawat pendamping harian</a> kami.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Keunggulan Layanan TransCare</h2>
      <p class="section-subtitle">Kenyamanan, keamanan, dan empati di setiap kilometer perjalanan medis Anda.</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">💰</div>
          <h3 style="margin:8px 0">Harga Terjangkau & Jelas</h3>
          <p style="color:#4a5568;font-size:.95rem">Penetapan tarif transparan berdasarkan jarak rute. Bebas kejutan biaya tambahan di akhir perjalanan.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">♿</div>
          <h3 style="margin:8px 0">Akses Ramah Kursi Roda</h3>
          <p style="color:#4a5568;font-size:.95rem">Kabin lapang dengan penahan kursi roda tersertifikasi keselamatan untuk lansia yang kesulitan berpindah tempat duduk.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">👨‍⚕️</div>
          <h3 style="margin:8px 0">Opsi Pendampingan Perawat</h3>
          <p style="color:#4a5568;font-size:.95rem">Perawat medis berlisensi siap mengawal pasien, memantau infus/oksigen, serta membantu mobilitas di RS.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🛡️</div>
          <h3 style="margin:8px 0">Armada Steril & Bersih</h3>
          <p style="color:#4a5568;font-size:.95rem">Kabin kendaraan didesinfeksi rutin berstandar medis untuk mencegah transmisi kuman atau bakteri patogen.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">⏰</div>
          <h3 style="margin:8px 0">Penjemputan Tepat Waktu</h3>
          <p style="color:#4a5568;font-size:.95rem">Driver kami tiba lebih awal sebelum jadwal kontrol dokter agar pasien tidak terlambat di rumah sakit.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">📍</div>
          <h3 style="margin:8px 0">Cakupan Area Luas</h3>
          <p style="color:#4a5568;font-size:.95rem">Melayani rute DKI Jakarta, BSD City, Tangerang, Tangerang Selatan, Depok, dan Rumah Sakit rujukan di Bogor.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Pertanyaan yang Sering Ditanyakan (FAQ)</h2>
      <div class="faq-list">
        {faqData.map(f => (
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">{f.question}</button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{f.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Perjalanan ke Rumah Sakit Jadi Bebas Stres</h2>
        <p>Jadwalkan armada TransCare untuk kontrol berkala atau kepulangan pasien dari rumah sakit bersama Joy of Care.</p>
        <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20pesan%20layanan%20antar%20jemput%20RS%20TransCare" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">Pesan TransCare via WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    padding: 48px 0 32px;
  }
  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }
  .breadcrumbs a {
    color: var(--color-primary);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .content-section {
    padding: 60px 0;
  }
  .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 12px;
  }
  .section-subtitle {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto 48px;
  }
  .cta-banner {
    background: linear-gradient(135deg, var(--color-primary) 0%, #247A3B 100%);
    color: white;
    padding: 48px;
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .cta-banner h2 {
    font-size: 1.8rem;
    margin-bottom: 12px;
    color: white;
  }
  .cta-banner p {
    font-size: 1.05rem;
    opacity: 0.95;
    margin-bottom: 24px;
  }
  .btn-lg {
    font-size: 1.05rem;
    padding: 14px 32px;
  }
</style>
