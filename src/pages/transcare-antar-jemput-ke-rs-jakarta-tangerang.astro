---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../consts';

export const prerender = true;

const title = "Transcare Antar Jemput Ke Rs Jakarta Tangerang";
const description = "Layanan antar jemput nyaman ke fasilitas kesehatan pilihan. Transportasi medis aman dan terjangkau. Chat WA 08811-118-911.";
const canonical = `${SITE_URL}/transcare-antar-jemput-ke-rs-jakarta-tangerang`;
---

<BaseLayout title={title} description={description} canonicalURL={canonical}>


  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a> <span>›</span> TransCare</nav>
      <h1>TransCare — <span class="text-primary">Antar Jemput</span> ke RS</h1>
      <p>Layanan antar jemput nyaman ke fasilitas kesehatan pilihan. Transportasi medis aman dan terjangkau. Chat WA 08811-118-91...</p>
      <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20transcare" class="btn btn-primary" style="margin-top:20px">Chat WhatsApp Sekarang</a>
    </div>
  </section>

  
  <section class="content-section">
    <div class="container">
      <h2 style="font-family:Montserrat,sans-serif;font-size:1.8rem;font-weight:700;margin-bottom:16px">TransCare: Antar Jemput Nyaman ke Fasilitas Kesehatan</h2>
      <p>TransCare dari Joy of Care menyediakan layanan transportasi medis yang aman dan nyaman ke rumah sakit, klinik, atau pusat rehabilitasi pilihan Anda. Layanan ini dirancang khusus untuk lansia, pasien pasca operasi, dan siapa pun yang membutuhkan penanganan ekstra selama perjalanan.</p>
      <p>Setiap armada diawaki oleh pengemudi dan perawat terlatih, menggunakan kendaraan premium yang disesuaikan untuk kebutuhan medis.</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:20px 0">
        <img src="/images/transcare-antar-jemput-ke-rs-jakarta-tangerang/1.jpg" alt="Armada TransCare antar jemput pasien ke rumah sakit" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
        <img src="/images/transcare-antar-jemput-ke-rs-jakarta-tangerang/2.jpg" alt="Tim perawat TransCare mendampingi pasien selama perjalanan" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
      </div>
      <h3 style="font-size:1.2rem;font-weight:600;margin:16px 0">Pilihan Layanan:</h3>
      <ul style="padding-left:20px;color:#4a5568">
        <li>Jemput dari rumah menuju fasilitas kesehatan</li>
        <li>Jemput dari rumah sakit/klinik setelah perawatan</li>
        <li>Pendampingan perawat dan penjelasan medis selama perjalanan</li>
        <li>Kendaraan premium yang dilengkapi peralatan pendukung medis</li>
      </ul>
      <p style="margin-top:12px"><strong>Area layanan saat ini:</strong> Jakarta dan Tangerang.</p>
    </div>
  </section>


  
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Kenapa Memilih Joy of Care</h2>
      <p class="section-subtitle">Layanan kesehatan profesional langsung ke rumah Anda, tanpa antre dan tanpa keluar rumah.</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🏠</div><h3 style="margin:8px 0">Kenyamanan di Rumah</h3>
          <p style="color:#4a5568;font-size:.95rem">Tidak perlu repot ke fasilitas kesehatan. Tenaga medis kami datang langsung ke rumah Anda.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">👨‍⚕️</div><h3 style="margin:8px 0">Tenaga Medis Profesional</h3>
          <p style="color:#4a5568;font-size:.95rem">Dokter, perawat, dan terapis berlisensi serta berpengalaman menangani pasien di rumah.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🕒</div><h3 style="margin:8px 0">Fleksibilitas Waktu</h3>
          <p style="color:#4a5568;font-size:.95rem">Kami siap melayani setiap hari, termasuk akhir pekan, sesuai jadwal yang Anda pilih.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🤝</div><h3 style="margin:8px 0">Perawatan Bersahabat</h3>
          <p style="color:#4a5568;font-size:.95rem">Tim kami peduli pada kesehatan Anda dan memberikan pendampingan yang ramah dan personal.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">💻</div><h3 style="margin:8px 0">Teknologi Terkini</h3>
          <p style="color:#4a5568;font-size:.95rem">Riwayat medis dipantau dan dikelola dengan teliti melalui sistem yang modern.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">📋</div><h3 style="margin:8px 0">Layanan Medis Lengkap</h3>
          <p style="color:#4a5568;font-size:.95rem">Pemeriksaan rutin lansia, perawatan luka, infus, vaksinasi, hingga fisioterapi di rumah.</p>
        </div>
      </div>
    </div>
  </section>

<section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Pertanyaan yang Sering Ditanyakan</h2>
      <div class="faq-list">
        <div class="faq-item"><button class="faq-question" aria-expanded="false">Bagaimana cara pesan layanan TransCare?</button><div class="faq-answer"><div class="faq-answer-inner">Hubungi WhatsApp kami di 08811-118-911, sampaikan lokasi penjemputan dan tujuan. Kami akan konfirmasi ketersediaan armada.</div></div></div>
        <div class="faq-item"><button class="faq-question" aria-expanded="false">Area layanan TransCare mencakup mana saja?</button><div class="faq-answer"><div class="faq-answer-inner">Kami melayani antar jemput di area BSD City, Tangerang, Tangerang Selatan, Jakarta, Depok, dan Bogor.</div></div></div>
        <div class="faq-item"><button class="faq-question" aria-expanded="false">Apakah ada pendamping selama perjalanan?</button><div class="faq-answer"><div class="faq-answer-inner">Ya, driver kami terlatih dalam penanganan pasien dan siap membantu selama perjalanan.</div></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Siap Memulai?</h2>
        <p>Hubungi kami sekarang untuk konsultasi atau informasi lebih lanjut.</p>
        <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20transcare" class="btn btn-lg">Chat WhatsApp</a>
      </div>
    </div>
  </section>

  
</BaseLayout>
