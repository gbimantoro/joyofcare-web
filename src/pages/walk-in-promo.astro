---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL, PROMO_WHATSAPP_URL } from '../consts';

export const prerender = true;

const title = "Terapi Medis & Vaksinasi Pilihan Hemat Hanya 300 Ribu | Joy of Care BSD";
const description = "Terapi medis & vaksinasi pilihan hemat hanya 300 ribu di Joy of Care BSD City: Vaksin Flu 3-Strain, Infus Imun Booster, Infus Anti GERD & Anti Hangover. Booking & Konsul dokter GRATIS!";
const canonical = `${SITE_URL}/walk-in-promo/`;
const ogImage = `/images/promo/vaksin-flu-3-strain.jpg`;

const promoPackages = [
  {
    id: "vaksin-flu",
    title: "Vaksinasi Flu / Influenza 3-Strain",
    headline: "Langkah mudah lindungi kita & orang tercinta",
    badge: "Vaksinasi Resmi Standar Depkes",
    originalPrice: "Rp 350.000",
    promoPrice: "Rp 300.000",
    saveAmount: "Hemat Rp 50.000",
    image: "/images/promo/vaksin-flu-3-strain.jpg",
    alt: "Vaksinasi Influenza 3 Strain Musiman Joy of Care BSD City",
    description: "Imunisasi influenza tahunan berstandar internasional untuk melindungi diri dan orang tersayang dari serangan virus flu musiman yang agresif, mencegah demam tinggi, batuk berat, dan komplikasi paru.",
    benefits: [
      "Memberikan antibodi protektif spesifik terhadap 3 jenis galur virus flu musiman",
      "Menurunkan risiko absensi kerja dan risiko penularan ke anak atau lansia di rumah",
      "Vaksin resmi terdaftar BPOM dengan cold chain (rantai dingin) terjaga higienis",
      "Skrining pra-tindakan dan penyuntikan aman oleh dokter umum profesional"
    ],
    recommendedFor: "Dewasa produktif, lansia dengan riwayat asma/alergi pernapasan, serta keluarga yang menginginkan proteksi tahunan."
  },
  {
    id: "imun-booster",
    title: "Infus Penambah Ketahanan Tubuh (Imun Booster)",
    headline: "Cegah sakit, anti-manyun yuk! Perkuat imun kamu",
    badge: "Paling Favorit • Proteksi Optimal",
    originalPrice: "Rp 360.000",
    promoPrice: "Rp 300.000",
    saveAmount: "Hemat Rp 60.000",
    image: "/images/promo/imun-booster.jpg",
    alt: "Infus Imun Booster Multivitamin Ketahanan Tubuh Joy of Care BSD City",
    description: "Suntikan multivitamin dan antioksidan dosis optimal melalui infus intravena yang diserap 100% oleh peredaran darah untuk mengoptimalkan sistem kekebalan tubuh di tengah cuaca ekstrem dan polusi udara tinggi.",
    benefits: [
      "Kombinasi vitamin esensial dosis tinggi untuk stimulasi produksi sel imun",
      "Bioavailabilitas 100% tanpa efek samping rasa perih di lambung",
      "Meningkatkan stamina, mengatasi rasa capek kronis (*burnout*), dan lesu",
      "Mencegah infeksi saluran pernapasan di musim pancaroba dan polusi kota"
    ],
    recommendedFor: "Eksekutif sibuk, mobilitas tinggi, yang merasa mulai meriang atau rentan tertular flu di lingkungan kerja dan keluarga."
  },
  {
    id: "anti-gerd",
    title: "Infus Anti GERD / Gastro Protector",
    headline: "Jalani hari tanpa nyeri lambung lagi",
    badge: "Solusi Cepat Asam Lambung",
    originalPrice: "Rp 350.000",
    promoPrice: "Rp 300.000",
    saveAmount: "Hemat Rp 50.000",
    image: "/images/promo/anti-gerd.jpg",
    alt: "Infus Anti GERD Asam Lambung Gastro Protector Joy of Care BSD City",
    description: "Terapi intravena gastro-protector medis untuk menetralkan asam lambung berlebih, meredakan iritasi mukosa lambung, dan mengembalikan kenyamanan pencernaan secara instan tanpa membebani sistem cerna oral.",
    benefits: [
      "Meredakan sensasi dada terbakar (heartburn) & perih ulu hati",
      "Mengatasi mual hebat, begah, perut kembung, dan rasa asam di mulut",
      "Formula pelindung mukosa lambung yang bekerja langsung via aliran darah",
      "Diobservasi langsung oleh dokter umum di ruang tindakan yang steril & nyaman"
    ],
    recommendedFor: "Penderita maag akut, dispepsia, GERD kambuhan, dan nyeri ulu hati pasca konsumsi makanan asam/pedas/kopi."
  },
  {
    id: "anti-hangover",
    title: "Infus Pereda Gejala Anti Hangover",
    headline: "Redakan gejalanya, badan pulih bertenaga lagi",
    badge: "Diskon Terbesar • Hemat Rp 80.000",
    originalPrice: "Rp 380.000",
    promoPrice: "Rp 300.000",
    saveAmount: "Hemat Rp 80.000",
    image: "/images/promo/anti-hangover.jpg",
    alt: "Infus Anti Hangover Pemulihan Cepat Joy of Care BSD City",
    description: "Rehidrasi cepat dan detoksifikasi tubuh pasca kelelahan berat, begadang lembur, atau konsumsi alkohol berlebih. Mengembalikan keseimbangan cairan elektrolit dan mikronutrien tubuh agar Anda kembali segar berenergi.",
    benefits: [
      "Rehidrasi cairan elektrolit esensial yang terkuras dalam hitungan menit",
      "Meredakan sakit kepala berdenyut, migrain ringan, pusing, dan rasa mual",
      "Kombinasi vitamin pemulihan energi seluler untuk mengusir rasa lemas",
      "Membantu percepatan eliminasi zat sisa metabolisme / detoksifikasi alami"
    ],
    recommendedFor: "Kelelahan ekstrem, jetlag pasca perjalanan jauh, kurang tidur akibat lembur, serta pemulihan pasca perayaan/pesta."
  }
];

const promoFaqs = [
  {
    question: "Apa syarat dan ketentuan untuk mendapatkan harga promo hemat hanya 300 ribu ini?",
    answer: "Harga promo hemat hanya 300 ribu berlaku khusus untuk pasien layanan walk-in (datang langsung) ke tempat praktik dokter Joy of Care di Ruko Greenwich Business Park E-15, BSD City, Tangerang Selatan. Anda disarankan melakukan reservasi slot kedatangan via WhatsApp terlebih dahulu agar langsung dilayani tanpa menunggu."
  },
  {
    question: "Apakah biaya 300 ribu sudah termasuk jasa dokter dan peralatan medis?",
    answer: "Ya, betul! Harga promo hemat hanya 300 ribu adalah harga all-in transparan, sudah mencakup obat/cairan vitamin/vaksin resmi BPOM, abocath dan set infus steril sekali pakai, jasa tindakan medis, serta GRATIS konsultasi awal dokter via WhatsApp."
  },
  {
    question: "Berapa lama durasi tindakan infus vitamin atau vaksinasi saat walk-in?",
    answer: "Untuk tindakan vaksinasi influenza hanya membutuhkan waktu sekitar 10-15 menit termasuk skrining tanda vital. Untuk tindakan terapi infus (Anti GERD, Anti Hangover, Imun Booster) berlangsung sekitar 35 hingga 50 menit di ruang tindakan yang sejuk, bersih, dan nyaman."
  },
  {
    question: "Bagaimana cara melakukan reservasi slot promo walk-in?",
    answer: "Caranya sangat mudah! Klik tombol 'Booking & Konsul dokter GRATIS' di halaman ini, kirim pesan WhatsApp ke nomor resmi Joy of Care di 08811-118-911, sebutkan nama dan paket promo yang dipilih, lalu tim medis kami akan mengonfirmasi jadwal kedatangan Anda."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonical}
  ogImage={ogImage}
>
  <!-- Schema: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${SITE_URL}/` },
      { "@type": "ListItem", "position": 2, "name": "Promo Walk-in BSD", "item": canonical }
    ]
  })} />

  <!-- Schema: OfferCatalog / SpecialAnnouncement -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    "name": "Promo Walk-in Joy of Care BSD City",
    "description": description,
    "url": canonical,
    "itemListElement": promoPackages.map(pkg => ({
      "@type": "Offer",
      "name": pkg.title,
      "description": pkg.description,
      "price": "300000",
      "priceCurrency": "IDR",
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-06-01",
      "url": canonical,
      "offeredBy": {
        "@type": "MedicalBusiness",
        "name": "Joy of Care BSD City",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Ruko Greenwich Business Park E-15, Jl. Bumi Botanika",
          "addressLocality": "BSD City",
          "addressRegion": "Tangerang Selatan",
          "postalCode": "15331",
          "addressCountry": "ID"
        },
        "telephone": "+628811118911"
      }
    }))
  })} />

  <!-- Schema: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": promoFaqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  })} />

  <!-- Hero Promo Section -->
  <section class="promo-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Beranda</a> <span>›</span>
        <span>Promo Walk-in</span>
      </nav>

      <div class="promo-hero-badge">
        <span class="badge-fire">🔥</span>
        <span>PROMO SPESIAL WALK-IN BSD CITY — HEMAT HANYA 300 RIBU</span>
      </div>

      <h1 class="promo-hero-title">
        Terapi Medis & Vaksinasi Pilihan <br>
        <span class="gradient-text">Hemat Hanya 300 Ribu</span>
      </h1>

      <p class="promo-hero-desc">
        Kabar baik untuk warga BSD City, Gading Serpong, Alam Sutera & sekitarnya! Nikmati paket perawatan infus medis dan vaksinasi dengan dokter umum berlisensi resmi di Joy of Care BSD. Tempat higienis, bebas antre, pelayanan ramah, dan <strong>Gratis Konsultasi Dokter via WhatsApp</strong>.
      </p>

      <div class="promo-hero-highlights">
        <div class="highlight-chip">
          <span class="chip-icon">🏷️</span>
          <span>Semua Paket Rp 300.000</span>
        </div>
        <div class="highlight-chip">
          <span class="chip-icon">🩺</span>
          <span>Dokter & Perawat Ber-STR Resmi</span>
        </div>
        <div class="highlight-chip">
          <span class="chip-icon">📍</span>
          <span>Ruko Greenwich Park E-15 BSD</span>
        </div>
        <div class="highlight-chip">
          <span class="chip-icon">💬</span>
          <span>Konsul Dokter WhatsApp GRATIS</span>
        </div>
      </div>

      <div class="promo-hero-cta-wrapper">
        <a href={PROMO_WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn-promo-cta btn-lg pulse-glow">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Booking & Konsul dokter GRATIS
        </a>
        <span class="cta-subtext">Slot harian terbatas demi kenyamanan & privasi tindakan setiap pasien</span>
      </div>
    </div>
  </section>

  <!-- 4 Promo Packages Showcase -->
  <section class="section promo-cards-section">
    <div class="container">
      <div class="section-header-center">
        <span class="badge-tag">PILIHAN PAKET PROMO</span>
        <h2 class="section-title">4 Paket Pilihan Promo Walk-in BSD</h2>
        <p class="section-subtitle">
          Pilih paket yang sesuai dengan kebutuhan kesehatan Anda. Seluruh tindakan dilaksanakan dengan standar medis ketat dan protokol aseptik.
        </p>
      </div>

      <div class="promo-grid">
        {promoPackages.map((pkg, idx) => (
          <article class="promo-card" id={pkg.id}>
            <div class="promo-card-image-wrap">
              <img
                src={pkg.image}
                alt={pkg.alt}
                width="540"
                height="540"
                loading={idx < 2 ? "eager" : "lazy"}
                class="promo-img"
              />
              <div class="promo-floating-tag">
                {pkg.badge}
              </div>
            </div>

            <div class="promo-card-body">
              <div class="promo-quote-banner">
                <span class="quote-icon">“</span>
                <span class="quote-text">{pkg.headline}</span>
                <span class="quote-icon">”</span>
              </div>

              <h3 class="promo-package-title">{pkg.title}</h3>

              <!-- Pricing Block -->
              <div class="promo-price-box">
                <div class="price-row">
                  <span class="price-label">Tarif Promo Walk-In:</span>
                  <div class="price-values">
                    <span class="price-strikethrough">{pkg.originalPrice}</span>
                    <span class="price-main">{pkg.promoPrice}</span>
                  </div>
                </div>
                <div class="price-save-badge">
                  <span>{pkg.saveAmount}</span> • All-in Bersih
                </div>
              </div>

              <p class="promo-desc">{pkg.description}</p>

              <div class="promo-benefits-box">
                <h4 class="benefits-title">Manfaat Utama:</h4>
                <ul class="benefits-list">
                  {pkg.benefits.map((b) => (
                    <li>
                      <span class="check-icon">✓</span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="promo-recommendation">
                <strong>Cocok untuk:</strong> {pkg.recommendedFor}
              </div>

              <div class="promo-card-cta">
                <a
                  href={PROMO_WHATSAPP_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-promo-cta btn-block"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  Booking & Konsul dokter GRATIS
                </a>
                <span class="cta-microcopy">Termasuk konsultasi pra-tindakan dengan dokter via WhatsApp</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Mengapa Memilih Joy of Care Walk-in -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header-center">
        <span class="badge-tag">STANDAR MEDIS RESMI</span>
        <h2 class="section-title">Mengapa Memilih Joy of Care BSD?</h2>
        <p class="section-subtitle">Pelayanan kesehatan berintegritas tinggi dengan kenyamanan privat seperti di rumah sendiri.</p>
      </div>

      <div class="features-grid">
        <div class="feature-box">
          <div class="feature-icon-badge">👨‍⚕️</div>
          <h3>Dokter & Perawat STR Aktif</h3>
          <p>Tindakan medis dikerjakan langsung oleh dokter dan perawat berlisensi resmi Kementerian Kesehatan yang berpengalaman dan mengutamakan keselamatan pasien (*patient safety*).</p>
        </div>

        <div class="feature-box">
          <div class="feature-icon-badge">✨</div>
          <h3>Ruang Tindakan Nyaman & Higienis</h3>
          <p>Praktik dokter berlokasi di kawasan eksklusif BSD City dengan ruang tindakan berpendingin udara (AC), tempat tidur nyaman, dan standar sanitasi aseptik rumah sakit.</p>
        </div>

        <div class="feature-box">
          <div class="feature-icon-badge">💊</div>
          <h3>Obat & Vaksin Resmi BPOM</h3>
          <p>Seluruh cairan infus, multivitamin konsentrat, dan vaksin influenza bersertifikasi resmi BPOM dari distributor farmasi legal dengan suhu *cold-chain* terjamin presisi.</p>
        </div>

        <div class="feature-box">
          <div class="feature-icon-badge">⏱️</div>
          <h3>Bebas Antre & Reservasi Praktis</h3>
          <p>Dengan sistem reservasi online via WhatsApp, Anda menentukan jam kedatangan sendiri tanpa perlu menunggu antrean berjam-jam seperti di rumah sakit besar.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lokasi & Cara Reservasi -->
  <section class="section location-details-section">
    <div class="container">
      <div class="location-wrapper">
        <div class="location-info">
          <span class="badge-tag">LOKASI & CARA BOOKING</span>
          <h2 class="location-title">Kunjungi Lokasi Joy of Care BSD City</h2>
          
          <div class="address-card">
            <div class="address-icon">📍</div>
            <div class="address-details">
              <strong>Praktik Dokter Joy of Care BSD</strong>
              <p>Ruko Greenwich Business Park E-15, Jl. Bumi Botanika, BSD City, Tangerang Selatan 15331</p>
              <div class="hours-badge">
                <span>🕒 Jam Layanan: <strong>07.00 – 21.00 WIB</strong> (Setiap Hari)</span>
              </div>
            </div>
          </div>

          <div class="booking-steps">
            <h4 class="steps-title">Langkah Mudah Mengikuti Promo:</h4>
            <ol class="steps-list">
              <li>
                <strong>Pilih Paket Promo:</strong> Tentukan layanan yang Anda butuhkan (Vaksin Flu, Imun Booster, Anti GERD, atau Anti Hangover).
              </li>
              <li>
                <strong>Klik Booking WhatsApp:</strong> Hubungi admin kami di 08811-118-911 untuk konfirmasi ketersediaan slot.
              </li>
              <li>
                <strong>Konsultasi Pra-Tindakan:</strong> Konsultasikan keluhan atau riwayat kesehatan Anda dengan dokter secara GRATIS.
              </li>
              <li>
                <strong>Datang & Dapatkan Perawatan:</strong> Hadir sesuai jam yang disepakati di Ruko Greenwich BSD dan nikmati pelayanan kesehatan prima.
              </li>
            </ol>
          </div>

          <div class="location-actions">
            <a href={PROMO_WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn-promo-cta btn-lg">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Booking & Konsul dokter GRATIS
            </a>
            <a href="https://maps.app.goo.gl/JwkLdvc11hQYs8ts6" target="_blank" rel="noopener noreferrer" class="btn-outline-map">
              Buka Google Maps
            </a>
          </div>
