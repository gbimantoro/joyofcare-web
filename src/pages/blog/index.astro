---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, categoryLabel } from '../../lib/categories';
import { SITE_URL } from '../../consts';

export const prerender = true;

const articles = await getCollection('articles');
const sortedArticles = articles.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const categoryNames: Record<string, string> = Object.fromEntries(
  CATEGORIES.map((c) => [c.slug, c.label])
);

const categoryThumbnails: Record<string, string> = Object.fromEntries(
  CATEGORIES.map((c) => [c.slug, `/assets/blog/${c.slug}.svg`])
);

const categories = Object.entries(categoryNames);
---

<BaseLayout 
  title="Artikel Kesehatan Homecare | Joy of Care"
  description="Temukan panduan lengkap perawatan lansia, fisioterapi di rumah, tips Parkinson & osteoporosis, panduan vaksinasi, serta persyaratan medis studi ke luar negeri."
  canonicalURL={`${SITE_URL}/blog/`}
>
  <section class="blog-header">
    <div class="container">
      <h1>Artikel Kesehatan Homecare</h1>
      <p>Panduan lengkap perawatan kesehatan di rumah dari tim medis Joy of Care</p>
    </div>
  </section>

  <section class="category-thumbnails">
    <div class="container">
      <h2 class="section-title">Kategori Artikel</h2>
      <div class="category-grid">
        {categories.map(([slug, name]) => (
          <a href={`/blog/${slug}/`} class="category-card">
            <img src={categoryThumbnails[slug]} alt={name} class="category-thumb" />
            <span class="category-name">{name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="blog-content">
    <div class="container">
      <div class="category-filter">
        <button class="filter-btn active" data-category="all">Semua</button>
        {categories.map(([slug, name]) => (
          <button class="filter-btn" data-category={slug}>{name}</button>
        ))}
      </div>

      <div class="articles-grid">
        {sortedArticles.map((article) => (
          <article class="article-card" data-category={article.data.category}>
            {article.data.featuredImage && (
              <img src={article.data.featuredImage} alt={article.data.title} class="article-image" />
            )}
            <div class="article-card-content">
              <span class="article-category">{categoryNames[article.data.category] || article.data.category}</span>
              <h2>
                <a href={`/blog/${article.data.category}/${article.data.slug}/`}>
                  {article.data.title}
                </a>
              </h2>
              <div class="article-meta">
                <time>{new Date(article.data.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-header {
    background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
    padding: 64px 0;
    text-align: center;
  }

  h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .blog-header p {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
  }

  .blog-content {
    padding: 48px 0;
  }

  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
    justify-content: center;
  }

  .filter-btn {
    padding: 8px 16px;
    border: 1px solid var(--color-border);
    background: white;
    border-radius: 100px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .article-card {
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .article-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .article-card-content {
    padding: 24px;
  }

  .article-category {
    display: inline-block;
    background: var(--color-neutral);
    color: var(--color-primary);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 12px;
    line-height: 1.4;
  }

  h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-primary);
  }

  .article-meta {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }

  .category-thumbnails {
    padding: 48px 0;
    background: var(--color-neutral);
  }

  .category-thumbnails .section-title {
    margin-bottom: 32px;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .category-card {
    display: block;
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: all 0.3s;
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .category-thumb {
    width: 100%;
    height: 140px;
    object-fit: cover;
  }

  .category-name {
    display: block;
    padding: 12px;
    text-align: center;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.875rem;
  }

  .category-card:hover .category-name {
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .category-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const category = btn.getAttribute('data-category');
      document.querySelectorAll<HTMLElement>('.article-card').forEach(card => {
        if (category === 'all' || card.getAttribute('data-category') === category) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
