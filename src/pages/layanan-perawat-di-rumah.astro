---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../consts';

export const prerender = true;

const title = "Layanan Perawat Di Rumah";
const description = "Layanan perawat homecare profesional di rumah. Perawatan pasca operasi, lansia, dan pasien kronis. Joy of Care melayani BSD, Tangerang, Jakarta. Chat WA 08811-118-911.";
const canonical = `${SITE_URL}/layanan-perawat-di-rumah`;
---

<BaseLayout title={title} description={description} canonicalURL={canonical}>


  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a> <span>›</span> Perawat</nav>
      <h1>Perawat <span class="text-primary">di Rumah</span></h1>
      <p>Layanan perawat homecare profesional di rumah untuk perawatan pasca operasi, lansia, dan pasien kronis. Joy of Care melayani BSD, Tangerang, dan Jakarta.</p>
      <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20perawat" class="btn btn-primary" style="margin-top:20px">Chat WhatsApp Sekarang</a>
    </div>
  </section>

  
  <section class="content-section">
    <div class="container">
      <h2 style="font-family:Montserrat,sans-serif;font-size:1.8rem;font-weight:700;margin-bottom:16px">Layanan Perawat Homecare Profesional</h2>
      <p>Perawat homecare Joy of Care adalah tenaga kesehatan terlatih yang memberikan perawatan medis dan dukungan di rumah pasien. Mereka membantu pasien menjalani proses pemulihan, mengelola kondisi kesehatan kronis, serta mendampingi aktivitas sehari-hari di lingkungan yang nyaman.</p>
      <p>Layanan ini ideal bagi pasien pasca rawat inap, lansia, dan keluarga yang menginginkan perawatan personal tanpa harus tinggal di rumah sakit.</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:20px 0">
        <img src="/images/layanan-perawat-di-rumah/1.jpg" alt="Perawat homecare Joy of Care merawat pasien lansia di rumah" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
        <img src="/images/layanan-perawat-di-rumah/2.jpg" alt="Perawat Joy of Care mendampingi pasien pasca operasi" style="width:100%;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.12)" loading="lazy">
      </div>
      <h3 style="font-size:1.2rem;font-weight:600;margin:16px 0">Layanan yang Tersedia:</h3>
      <ul style="padding-left:20px;color:#4a5568">
        <li>Perawatan pasca rawat, operasi, dan stroke</li>
        <li>Manajemen penyakit kronis (diabetes, hipertensi)</li>
        <li>Perawatan lansia harian</li>
        <li>Terapi fisik dan rehabilitasi ringan</li>
        <li>Bantuan aktivitas sehari-hari (makan, mandi, berpindah posisi)</li>
        <li>Pemberian obat dan perawatan luka</li>
        <li>Penggantian kateter urine dan selang makanan (NGT)</li>
      </ul>
    </div>
  </section>


  
  <section class="section">
    <div class="container">
      <h2 class="section-title">Pilih Paket yang Sesuai Kebutuhan</h2>
      <p class="section-subtitle">Tersedia paket harian (24 jam), mingguan (7 hari), dan bulanan (28 hari).</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px">
        <div style="background:#f7fafc;padding:20px;border-radius:12px"><h4 style="margin-bottom:6px">Harian (24 Jam)</h4><p style="color:#4a5568;font-size:.92rem">Perawat mendampingi penuh selama 24 jam untuk perawatan intensif jangka pendek.</p></div>
        <div style="background:#f7fafc;padding:20px;border-radius:12px"><h4 style="margin-bottom:6px">Mingguan (7 Hari)</h4><p style="color:#4a5568;font-size:.92rem">Perawatan berkelanjutan selama seminggu untuk pemulihan yang konsisten.</p></div>
        <div style="background:#f7fafc;padding:20px;border-radius:12px"><h4 style="margin-bottom:6px">Bulanan (28 Hari)</h4><p style="color:#4a5568;font-size:.92rem">Solusi jangka panjang untuk perawatan lansia dan pasien kronis di rumah.</p></div>
      </div>
      <p style="text-align:center;margin-top:24px"><strong>Area layanan:</strong> BSD City, Tangerang Selatan, Tangerang, Jakarta, Depok, dan Bogor.</p>
    </div>
  </section>


  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Kenapa Memilih Joy of Care</h2>
      <p class="section-subtitle">Layanan kesehatan profesional langsung ke rumah Anda, tanpa antre dan tanpa keluar rumah.</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🏠</div><h3 style="margin:8px 0">Kenyamanan di Rumah</h3>
          <p style="color:#4a5568;font-size:.95rem">Tidak perlu repot ke fasilitas kesehatan. Tenaga medis kami datang langsung ke rumah Anda.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">👨‍⚕️</div><h3 style="margin:8px 0">Tenaga Medis Profesional</h3>
          <p style="color:#4a5568;font-size:.95rem">Dokter, perawat, dan terapis berlisensi serta berpengalaman menangani pasien di rumah.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🕒</div><h3 style="margin:8px 0">Fleksibilitas Waktu</h3>
          <p style="color:#4a5568;font-size:.95rem">Kami siap melayani setiap hari, termasuk akhir pekan, sesuai jadwal yang Anda pilih.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🤝</div><h3 style="margin:8px 0">Perawatan Bersahabat</h3>
          <p style="color:#4a5568;font-size:.95rem">Tim kami peduli pada kesehatan Anda dan memberikan pendampingan yang ramah dan personal.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">💻</div><h3 style="margin:8px 0">Teknologi Terkini</h3>
          <p style="color:#4a5568;font-size:.95rem">Riwayat medis dipantau dan dikelola dengan teliti melalui sistem yang modern.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">📋</div><h3 style="margin:8px 0">Layanan Medis Lengkap</h3>
          <p style="color:#4a5568;font-size:.95rem">Pemeriksaan rutin lansia, perawatan luka, infus, vaksinasi, hingga fisioterapi di rumah.</p>
        </div>
      </div>
    </div>
  </section>

<section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Pertanyaan yang Sering Ditanyakan</h2>
      <div class="faq-list">
        <div class="faq-item"><button class="faq-question">Apa beda perawat homecare dengan perawat rumah sakit?</button><div class="faq-answer"><div class="faq-answer-inner">Perawat homecare datang ke rumah Anda, memberikan perawatan personal di lingkungan yang nyaman, dan biayanya lebih terjangkau karena tidak ada biaya rawat inap.</div></div></div>
        <div class="faq-item"><button class="faq-question">Berapa lama layanan perawat bisa dipesan?</button><div class="faq-answer"><div class="faq-answer-inner">Kami menyediakan paket harian (24 jam), mingguan (7 hari), dan bulanan (28 hari) sesuai kebutuhan Anda.</div></div></div>
        <div class="faq-item"><button class="faq-question">Apakah perawat bisa menangani pasien pasca operasi?</button><div class="faq-answer"><div class="faq-answer-inner">Ya, perawat kami terlatih menangani pasien pasca operasi termasuk perawatan luka, pemberian obat, dan pemulihan mandiri.</div></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Siap Memulai?</h2>
        <p>Hubungi kami sekarang untuk konsultasi atau informasi lebih lanjut.</p>
        <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20perawat" class="btn btn-lg">Chat WhatsApp</a>
      </div>
    </div>
  </section>

  
</BaseLayout>
