---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../consts';

export const prerender = true;

const title = "Vaksin di Rumah Jakarta & Tangerang untuk Lansia & Keluarga | Joy of Care";
const description = "Layanan vaksin di rumah Jakarta & Tangerang untuk lansia dan keluarga: influenza quadrivalent, pneumonia PCV13, shingles, hepatitis, dan MCU studi luar negeri. Dokter berizin Dinkes.";
const canonical = `${SITE_URL}/layanan-vaksinasi-di-rumah/`;

const faqData = [
  {
    question: "Vaksin apa saja yang wajib dan sangat dianjurkan untuk lansia di rumah?",
    answer: "Untuk kelompok usia 50 tahun ke atas, PAPDI merekomendasikan: Vaksin Influenza Quadrivalent tahunan (melindungi dari superflu H3N2 dan varian influenza A/B), Vaksin Pneumonia (PCV13 dilanjutkan PPSV23 untuk mencegah radang paru fatal), serta Vaksin Herpes Zoster (Shingles) untuk mencegah cacar api dan nyeri saraf kronis pasca-herpes."
  },
  {
    question: "Bagaimana Joy of Care menjamin kualitas dan keamanan suhu vaksin (cold chain)?",
    answer: "Seluruh vaksin disimpan dan dibawa dalam medical cooler box berinsulasi ganda dengan data logger suhu digital realtime (2°C hingga 8°C). Rantai dingin ini dipantau ketat sejak pengambilan dari fasilitas berizin resmi hingga disuntikkan ke pasien di rumah."
  },
  {
    question: "Apakah Joy of Care melayani vaksinasi dan pengisian sertifikat medis studi ke luar negeri?",
    answer: "Ya. Dokter kami dapat memberikan vaksinasi yang dipersyaratkan universitas dan visa luar negeri (MMR, Hepatitis B, Meningitis, Varicella, Polio, Tetanus/Tdap) serta mengisi dan menandatangani formulir resmi (Immunisation Compliance Form) untuk studi ke Australia, Inggris (UK), Amerika Serikat, Jepang, dan negara lainnya."
  },
  {
    question: "Berapa biaya vaksinasi di rumah dan apakah sudah termasuk jasa dokter?",
    answer: "Biaya vaksinasi Joy of Care bersifat transparan dan all-in, sudah mencakup biaya vaksin asli berizin BPOM, spuit steril sekali pakai, biaya visit dokter berizin STR/SIP, serta biaya transportasi tenaga medis langsung ke rumah Anda di area Jabodetabek. Hubungi WhatsApp 08811-118-911 untuk daftar harga lengkap."
  }
];
---

<BaseLayout title={title} description={description} canonicalURL={canonical}>
  <!-- Schema: MedicalProcedure -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": "Layanan Vaksinasi di Rumah Joy of Care",
    "description": description,
    "url": canonical,
    "procedureType": "http://schema.org/PercutaneousProcedure",
    "provider": {
      "@type": "MedicalBusiness",
      "name": "Joy of Care",
      "telephone": "+628811118911",
      "url": `${SITE_URL}/`
    },
    "areaServed": ["Jakarta", "Tangerang", "Tangerang Selatan", "Depok", "Bogor"]
  })} />

  <!-- Schema: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${SITE_URL}/` },
      { "@type": "ListItem", "position": 2, "name": "Layanan", "item": `${SITE_URL}/layanan-lengkap/` },
      { "@type": "ListItem", "position": 3, "name": "Vaksinasi di Rumah", "item": canonical }
    ]
  })} />

  <!-- Schema: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqData.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  })} />

  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Beranda</a> <span>›</span>
        <a href="/layanan-lengkap/">Layanan</a> <span>›</span>
        Vaksinasi di Rumah
      </nav>
      <h1>Vaksin di Rumah <span class="text-primary">Jakarta & Lansia</span></h1>
      <p>Layanan imunisasi dan vaksinasi profesional langsung di rumah Anda. Melindungi lansia dari flu, pneumonia, dan herpes zoster, serta melayani vaksin studi luar negeri oleh dokter berizin resmi.</p>
      <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20tanya%20layanan%20vaksinasi%20di%20rumah" class="btn btn-primary" style="margin-top:20px" target="_blank" rel="noopener noreferrer">Konsultasi Vaksin via WhatsApp</a>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <h2 style="font-family:Montserrat,sans-serif;font-size:1.8rem;font-weight:700;margin-bottom:16px">Vaksinasi Nyaman dan Aman di Rumah Bersama Joy of Care</h2>
      <p>Layanan <strong>vaksin di rumah jakarta lansia</strong> dan keluarga dari Joy of Care dirancang khusus untuk memberikan perlindungan kekebalan tubuh optimal tanpa rasa cemas terpapar infeksi di ruang tunggu rumah sakit. Terutama bagi orang tua lanjut usia yang rentan mengalami komplikasi pernapasan berat, vaksinasi langsung di tempat tidur menjadi pilihan paling aman dan efisien.</p>
      <p>Seluruh prosedur penyuntikan vaksin dilakukan langsung oleh dokter umum dan konsultan geriatri berizin resmi (memiliki STR dan SIP aktif Dinkes). Vaksin dijamin 100% asli bersertifikasi BPOM dengan standar penyimpanan rantai dingin (*cold chain*) berstandar internasional.</p>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:32px 0">
        <div style="background:#f8fafc;padding:24px;border-radius:12px;border-left:4px solid var(--color-primary)">
          <h3 style="font-size:1.2rem;font-weight:700;margin-bottom:12px;color:var(--color-primary)">🛡️ Vaksinasi Geriatri & Lansia</h3>
          <ul style="padding-left:20px;color:#4a5568;line-height:1.8">
            <li><strong>Vaksin Influenza Quadrivalent</strong> (melindungi dari 4 strain virus flu musiman terbaru)</li>
            <li><strong>Vaksin Pneumonia Konjugat (PCV13 / PPSV23)</strong> (mencegah radang paru dan sepsis)</li>
            <li><strong>Vaksin Herpes Zoster (Shingles)</strong> (mencegah cacar api dan neuralgia paska herpes)</li>
            <li><strong>Vaksin Booster Hepatitis B & Dewasa</strong></li>
          </ul>
        </div>
        <div style="background:#f8fafc;padding:24px;border-radius:12px;border-left:4px solid var(--color-cta)">
          <h3 style="font-size:1.2rem;font-weight:700;margin-bottom:12px;color:var(--color-cta)">✈️ Vaksin Studi ke Luar Negeri & Visa</h3>
          <ul style="padding-left:20px;color:#4a5568;line-height:1.8">
            <li><strong>Vaksin MMR & Varicella</strong> (syarat wajib kampus Australia & UK)</li>
            <li><strong>Vaksin Meningitis Meningokokus & Tdap</strong></li>
            <li><strong>Pemeriksaan Serologi Titer Antibodi di Rumah</strong></li>
            <li><strong>Pengisian & Legalisir Form Medis Resmi (Immunisation Record)</strong></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Mengapa Memilih Layanan Vaksin di Rumah Joy of Care?</h2>
      <p class="section-subtitle">Standar medis rumah sakit terkemuka kini hadir di ruang keluarga Anda.</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">❄️</div>
          <h3 style="margin:8px 0">Garansi Suhu Cold Chain 2-8°C</h3>
          <p style="color:#4a5568;font-size:.95rem">Vaksin dibawa dalam medical cooler box bersensor digital untuk menjaga keampuhan potensi antigen vaksin.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">👨‍⚕️</div>
          <h3 style="margin:8px 0">Disuntik Langsung oleh Dokter</h3>
          <p style="color:#4a5568;font-size:.95rem">Skrining tanda vital komprehensif dilakukan sebelum vaksinasi, serta observasi KIPI selama 15 menit pascatindakan.</p>
        </div>
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.1)">
          <div style="font-size:2rem">🚗</div>
          <h3 style="margin:8px 0">Harga All-in Termasuk Transport</h3>
          <p style="color:#4a5568;font-size:.95rem">Tidak ada biaya tersembunyi. Tarif all-in mencakup vaksin asli BPOM, kit steril medis, dan transport dokter.</p>
        </div>
      </div>
      <p style="text-align:center;margin-top:32px"><strong>Cakupan Wilayah Kunjungan:</strong> Jakarta (Pusat, Selatan, Barat, Timur, Utara), BSD City, Gading Serpong, Alam Sutera, Tangerang Selatan, Depok, dan Bogor.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Pertanyaan yang Sering Ditanyakan (FAQ)</h2>
      <div class="faq-list">
        {faqData.map(f => (
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">{f.question}</button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{f.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Lindungi Orang Tua & Keluarga Anda Sekarang</h2>
        <p>Jadwalkan kunjungan dokter untuk vaksinasi lansia di rumah Anda hari ini. Konsultasi gratis via WhatsApp.</p>
        <a href="https://wa.me/628811118911?text=Hi,%20saya%20tahu%20dari%20web.%20Mau%20jadwalkan%20vaksin%20lansia%20di%20rumah" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">Jadwalkan Vaksin via WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    padding: 48px 0 32px;
  }
  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }
  .breadcrumbs a {
    color: var(--color-primary);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .content-section {
    padding: 60px 0;
  }
  .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 12px;
  }
  .section-subtitle {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto 48px;
  }
  .cta-banner {
    background: linear-gradient(135deg, var(--color-primary) 0%, #247A3B 100%);
    color: white;
    padding: 48px;
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .cta-banner h2 {
    font-size: 1.8rem;
    margin-bottom: 12px;
    color: white;
  }
  .cta-banner p {
    font-size: 1.05rem;
    opacity: 0.95;
    margin-bottom: 24px;
  }
  .btn-lg {
    font-size: 1.05rem;
    padding: 14px 32px;
  }
</style>
