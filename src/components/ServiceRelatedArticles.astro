---
import { getCollection } from 'astro:content';
import { categoryLabel } from '../lib/categories';

interface Props {
  categories: string | string[];
  title?: string;
  subtitle?: string;
  limit?: number;
  viewAllSlug?: string;
  viewAllLabel?: string;
}

const {
  categories,
  title = "Panduan Medis & Artikel Terkait",
  subtitle = "Pelajari prosedur klinis, tips pemulihan di rumah, dan panduan kesehatan terverifikasi dari tim medis Joy of Care.",
  limit = 3,
  viewAllSlug,
  viewAllLabel
} = Astro.props;

const targetCats = Array.isArray(categories) ? categories : [categories];
const primaryCat = viewAllSlug || targetCats[0];
const primaryCatName = categoryLabel(primaryCat);

const allArticles = await getCollection('articles');
const matchedArticles = allArticles
  .filter(a => targetCats.includes(a.data.category))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const totalCount = matchedArticles.length;
const displayArticles = matchedArticles.slice(0, limit);
---

{displayArticles.length > 0 && (
  <section class="service-related-section">
    <div class="container">
      <div class="section-header-box">
        <div class="category-badge-chip">
          <span class="chip-dot"></span>
          <span>Edukasi Medis &amp; Panduan Terkait</span>
        </div>
        <h2 class="section-heading">{title}</h2>
        <p class="section-subheading">{subtitle}</p>
      </div>

      <div class="service-articles-grid">
        {displayArticles.map((article) => {
          const cat = article.data.category;
          const slug = article.data.slug;
          const artUrl = `/blog/${cat}/${slug}/`;
          const thumb = article.data.featuredImage || `/assets/blog/${cat}.svg`;
          const formattedDate = new Date(article.data.date).toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'short',
            year: 'numeric'
          });

          return (
            <article class="service-article-card">
              <a href={artUrl} class="card-thumb-link" aria-label={article.data.title}>
                <img
                  src={thumb}
                  alt={article.data.title}
                  width="400"
                  height="225"
                  loading="lazy"
                  decoding="async"
                  class="card-thumb-img"
                />
                <span class="card-cat-badge">{categoryLabel(cat)}</span>
              </a>
              <div class="card-body">
                <div class="card-meta-top">
                  <time datetime={new Date(article.data.date).toISOString()}>{formattedDate}</time>
                  <span class="meta-separator">•</span>
                  <span class="meta-doctor-badge">✓ Tim Medis JoC</span>
                </div>
                <h3 class="card-title">
                  <a href={artUrl}>{article.data.title}</a>
                </h3>
                <p class="card-desc">{article.data.metaDescription}</p>
                <div class="card-action">
                  <a href={artUrl} class="read-more-link">
                    <span>Baca Panduan</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div class="view-all-wrapper">
        <a href={`/blog/${primaryCat}/`} class="btn-view-all-cat">
          <span>{viewAllLabel || `Jelajahi Seluruh Artikel ${primaryCatName} (${totalCount})`}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .service-related-section {
    padding: 64px 0;
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }

  .section-header-box {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 40px;
  }

  .category-badge-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00bf63;
  }

  .section-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .section-subheading {
    color: #475569;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }

  .service-articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .service-article-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .service-article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(15, 23, 42, 0.1);
    border-color: #cbd5e1;
  }

  .card-thumb-link {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0f172a;
    overflow: hidden;
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-article-card:hover .card-thumb-img {
    transform: scale(1.04);
  }

  .card-cat-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.01em;
  }

  .card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: #64748b;
    margin-bottom: 10px;
  }

  .meta-doctor-badge {
    color: #0d9488;
    font-weight: 600;
  }

  .card-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 10px;
    color: #0f172a;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title a:hover {
    color: #0d9488;
  }

  .card-desc {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.55;
    margin: 0 0 18px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .card-action {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid #f1f5f9;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 700;
    color: #0d9488;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .read-more-link:hover {
    color: #0f766e;
    gap: 9px;
  }

  .view-all-wrapper {
    text-align: center;
  }

  .btn-view-all-cat {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border: 2px solid #0d9488;
    color: #0d9488;
    padding: 12px 24px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(13, 148, 136, 0.08);
    transition: all 0.25s ease;
  }

  .btn-view-all-cat:hover {
    background: #0d9488;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(13, 148, 136, 0.2);
  }

  @media (max-width: 992px) {
    .service-articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
    .section-heading {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 640px) {
    .service-articles-grid {
      grid-template-columns: 1fr;
    }
    .service-related-section {
      padding: 48px 0;
    }
    .section-heading {
      font-size: 1.5rem;
    }
    .btn-view-all-cat {
      width: 100%;
      justify-content: center;
    }
  }
</style>
