---
import BaseLayout from './BaseLayout.astro';
import { categoryLabel } from '../lib/categories';
import { SITE_URL } from '../consts';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  metaTitle?: string;
  metaDescription?: string;
  category: string;
  author?: string;
  reviewer?: string;
  date: Date;
  slug: string;
  featuredImage?: string;
  infographic?: string;
  primaryKeyword?: string;
  secondaryKeywords?: string[];
  faq?: FaqItem[];
}

const {
  title,
  metaTitle,
  metaDescription,
  category,
  author = 'Tim Kontributor Artikel',
  reviewer = 'Tim Medis Joy of Care',
  date,
  slug,
  featuredImage,
  infographic,
  faq = [],
} = Astro.props;

const catName = categoryLabel(category);
const canonicalURL = `${SITE_URL}/blog/${category}/${slug}/`;
const displayTitle = metaTitle || `${title} | Joy of Care`;
const description =
  metaDescription || `Baca artikel lengkap tentang ${title} di Joy of Care. Konsultasi gratis via WhatsApp 08811-118-911.`;
const isoDate = date.toISOString();
const waUrl = `https://wa.me/628811118911?text=${encodeURIComponent(
  'Hi, saya tahu dari web. Mau konsultasi gratis dengan dokter'
)}`;
const fullOgImage = featuredImage ? (featuredImage.startsWith('http') ? featuredImage : `${SITE_URL}${featuredImage.startsWith('/') ? '' : '/'}${featuredImage}`) : `${SITE_URL}/images/joc_long.png`;
---

<BaseLayout
  title={displayTitle}
  description={description}
  canonicalURL={canonicalURL}
  ogImage={fullOgImage}
>
  <!-- MedicalWebPage + Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": title,
    "description": description,
    "url": canonicalURL,
    "image": fullOgImage,
    "datePublished": isoDate,
    "dateModified": isoDate,
    "inLanguage": "id-ID",
    "author": { "@type": "Organization", "name": "Joy of Care" },
    "publisher": {
      "@type": "Organization",
      "name": "Joy of Care",
      "logo": { "@type": "ImageObject", "url": `${SITE_URL}/images/joc_long.png` }
    },
    "medicalAudience": { "@type": "PatientAudience", "audienceType": "Patient" }
  })} />

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${SITE_URL}/` },
      { "@type": "ListItem", "position": 2, "name": "Artikel", "item": `${SITE_URL}/blog/` },
      { "@type": "ListItem", "position": 3, "name": catName, "item": `${SITE_URL}/blog/${category}/` },
      { "@type": "ListItem", "position": 4, "name": title, "item": canonicalURL }
    ]
  })} />

  <!-- FAQPage Schema (from frontmatter faq) -->
  {faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faq.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer }
      }))
    })} />
  )}

  <article class="article">
    <header class="article-header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Beranda</a> <span>›</span>
          <a href="/blog/">Artikel</a> <span>›</span>
          <a href={`/blog/${category}/`}>{catName}</a>
        </nav>

        <span class="article-category">{catName}</span>
        <h1>{title}</h1>

        <div class="article-meta">
          <span class="article-author">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
            {author}
          </span>
          <span class="article-reviewer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
            </svg>
            Direview oleh: {reviewer}
          </span>
          <span class="article-read-time">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            5 menit baca
          </span>
          <time datetime={isoDate}>
            {new Date(date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>
      </div>
    </header>

    {featuredImage && (
      <div class="article-featured-image">
        <div class="container">
          <img src={featuredImage} alt={title} loading="eager" />
        </div>
      </div>
    )}

    {infographic && (
      <div class="article-infographic">
        <div class="container">
          <img src={infographic} alt={`Infografis: ${title}`} loading="lazy" />
        </div>
      </div>
    )}

    <div class="article-content">
      <div class="container">
        <div class="article-body">
          <slot />

          {faq.length > 0 && (
            <section class="faq-section">
              <h2>Pertanyaan yang Sering Diajukan</h2>
              <div class="faq-list">
                {faq.map((f) => (
                  <div class="faq-item">
                    <button class="faq-question" aria-expanded="false" type="button">
                      <span>{f.question}</span>
                    </button>
                    <div class="faq-answer">
                      <div class="faq-answer-inner">
                        <p>{f.answer}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          <p class="disclaimer">
            Artikel ini hanya untuk tujuan informasi kesehatan dan bukan pengganti konsultasi medis profesional.
            Konsultasikan kondisi kesehatan Anda dengan dokter yang berizin.
          </p>
        </div>

        <aside class="article-sidebar">
          <div class="cta-box">
            <h3>Konsultasi Gratis</h3>
            <p>Hubungi kami untuk konsultasi atau informasi lebih lanjut.</p>
            <a href={waUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Chat WhatsApp</a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <style>
    .article {
      width: 100%;
      max-width: 100%;
      overflow-x: hidden;
    }
    .article-header {
      background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
      padding: 48px 0 32px;
    }
    .breadcrumbs {
      font-size: 0.875rem; color: var(--color-text-secondary); margin-bottom: 16px;
    }
    .breadcrumbs a { color: var(--color-primary); text-decoration: none; }
    .breadcrumbs a:hover { text-decoration: underline; }
    .article-category {
      display: inline-block; background: var(--color-primary); color: #fff;
      padding: 4px 12px; border-radius: var(--radius-sm); font-size: 0.75rem;
      font-weight: 600; text-transform: uppercase; margin-bottom: 12px;
    }
    h1 {
      font-family: 'Montserrat', sans-serif;
      font-size: 2.25rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 16px;
      overflow-wrap: break-word;
      word-wrap: break-word;
    }
    .article-meta { display: flex; flex-wrap: wrap; gap: 16px; font-size: 0.875rem; color: var(--color-text-secondary); }
    .article-meta span, .article-meta time { display: flex; align-items: center; gap: 6px; }
    .article-featured-image { margin-top: -24px; margin-bottom: 40px; }
    .article-featured-image img {
      width: 100%;
      height: auto;
      aspect-ratio: 1200 / 630;
      max-height: 560px;
      object-fit: cover;
      border-radius: 20px;
      box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
      border: 1px solid #e2e8f0;
    }
    .article-infographic { margin-bottom: 40px; }
    .article-infographic img { width: 100%; max-height: 600px; object-fit: contain; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); background: white; padding: 16px; }
    .article-content .container {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 48px;
      padding-top: 40px;
      width: 100%;
      max-width: var(--max-width);
      box-sizing: border-box;
      min-width: 0;
    }
    .article-body {
      font-size: 1.1rem;
      line-height: 1.8;
      min-width: 0;
      max-width: 100%;
      overflow-wrap: break-word;
      word-wrap: break-word;
    }
    .article-body :global(h2) { font-family: 'Montserrat', sans-serif; font-size: 1.5rem; font-weight: 700; margin: 40px 0 16px; }
    .article-body :global(h3) { font-size: 1.25rem; font-weight: 600; margin: 32px 0 12px; }
    .article-body :global(p) { margin-bottom: 20px; }
    .article-body :global(ul), .article-body :global(ol) { margin: 16px 0; padding-left: 24px; }
    .article-body :global(li) { margin-bottom: 8px; }
    .article-body :global(blockquote) { border-left: 4px solid var(--color-primary); padding: 16px 24px; margin: 24px 0; background: var(--color-neutral); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; overflow-wrap: break-word; }
    .article-body :global(a) { color: var(--color-primary); word-break: break-word; }
    .article-body :global(table) {
      width: 100%;
      max-width: 100%;
      border-collapse: collapse;
      margin: 28px 0;
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
    }
    .article-body :global(th),
    .article-body :global(td) {
      padding: 12px 16px;
      border: 1px solid var(--color-border);
      text-align: left;
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .article-body :global(th) {
      background: var(--color-neutral);
      font-weight: 600;
      color: var(--color-text);
      white-space: nowrap;
    }
    .article-body :global(tr:nth-child(even) td) {
      background: #fafbfc;
    }
    .article-body :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-md); }
    .article-body :global(pre) { max-width: 100%; overflow-x: auto; padding: 16px; border-radius: var(--radius-md); background: var(--color-neutral); margin: 20px 0; }
    .article-body :global(code) { word-break: break-word; }
    .article-body :global(iframe) { max-width: 100%; }

    /* FAQ Section */
    .faq-section { margin-top: 40px; width: 100%; max-width: 100%; }
    .faq-section h2 { font-family: 'Montserrat', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 24px; }
    .faq-section .faq-list { max-width: 100%; margin: 0; width: 100%; }
    .faq-section .faq-item {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      margin-bottom: 12px;
      background: white;
      overflow: hidden;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .faq-section .faq-item.active {
      border-color: var(--color-primary);
      box-shadow: var(--shadow-sm);
    }
    .faq-section .faq-question {
      width: 100%;
      background: var(--color-neutral);
      border: none;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      cursor: pointer;
      font-family: 'Montserrat', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      text-align: left;
      transition: background 0.2s, color 0.2s;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    .faq-section .faq-question span {
      flex: 1;
      line-height: 1.4;
    }
    .faq-section .faq-question:hover {
      background: var(--color-primary-light);
    }
    .faq-section .faq-item.active .faq-question {
      background: var(--color-primary-light);
      color: var(--color-primary-dark);
    }
    .faq-section .faq-question::after {
      content: '+';
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--color-primary);
      transition: transform 0.25s ease;
      flex-shrink: 0;
      line-height: 1;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .faq-section .faq-item.active .faq-question::after {
      content: '−';
      color: var(--color-primary);
      transform: none;
    }
    .faq-section .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .faq-section .faq-item.active .faq-answer {
      max-height: 1200px;
    }
    .faq-section .faq-answer-inner {
      padding: 16px 20px 20px;
      color: var(--color-text-secondary);
      font-size: 0.975rem;
      line-height: 1.7;
      border-top: 1px solid var(--color-border);
    }
    .faq-section .faq-answer-inner p {
      margin-bottom: 0;
    }

    .disclaimer { font-size: 0.8rem; color: var(--color-text-secondary); border-top: 1px solid var(--color-border); margin-top: 40px; padding-top: 16px; font-style: italic; }
    .article-sidebar { position: sticky; top: 100px; height: fit-content; }
    .cta-box { background: linear-gradient(135deg, var(--color-primary) 0%, #247A3B 100%); color: #fff; padding: 32px; border-radius: var(--radius-lg); text-align: center; }
    .cta-box h3 { font-size: 1.25rem; margin-bottom: 8px; color: #fff; }
    .cta-box p { font-size: 0.9rem; color: #fff; margin-bottom: 20px; }
    .btn { display: inline-block; padding: 12px 24px; border-radius: var(--radius-sm); font-weight: 600; text-decoration: none; transition: all 0.2s; }
    .btn-primary { background: #fff; color: var(--color-primary); }
    .btn-primary:hover { background: var(--color-neutral); transform: translateY(-2px); }

    @media (max-width: 1024px) {
      .article-content .container { grid-template-columns: 1fr; }
      .article-sidebar { position: static; }
    }
    @media (max-width: 768px) {
      .article-header { padding: 32px 0 24px; }
      h1 { font-size: 1.65rem; }
      .article-meta { flex-direction: column; gap: 8px; }
      .article-content .container { padding-top: 24px; gap: 32px; }
      .article-body { font-size: 1rem; line-height: 1.7; }
      .article-body :global(h2) { font-size: 1.3rem; margin: 32px 0 12px; }
      .article-body :global(h3) { font-size: 1.15rem; margin: 24px 0 10px; }
      .article-body :global(blockquote) { padding: 12px 16px; margin: 16px 0; }
      .article-body :global(th),
      .article-body :global(td) { padding: 10px 12px; font-size: 0.875rem; }
      .article-featured-image { margin-top: -10px; margin-bottom: 24px; }
      .article-infographic { margin-bottom: 24px; }
      .faq-section { margin-top: 32px; }
      .faq-section h2 { font-size: 1.3rem; margin-bottom: 16px; }
      .faq-section .faq-question {
        padding: 14px 16px;
        font-size: 0.95rem;
        min-height: 48px;
        gap: 12px;
      }
      .faq-section .faq-question::after {
        font-size: 1.25rem;
      }
      .faq-section .faq-answer-inner {
        padding: 12px 16px 16px;
        font-size: 0.925rem;
      }
    }
  </style>
</BaseLayout>